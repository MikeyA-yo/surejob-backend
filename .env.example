# Copy to .env (never commit .env). Every value here is optional; shown with its default.

PORT=8080
HOST=127.0.0.1
# Auth: HS256 key for login tokens (32+ characters). Unset = random per start, so logins end on restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL=7d

# Storage: MongoDB when MONGO_URI is set, otherwise the SQLite file at DB_PATH (works offline).
# Use a database only this app writes to: POST /api/demo/reset empties its users and jobs.
MONGO_URI=
MONGO_DB=surejob
DB_PATH=data/surejob.db
# Comma-separated browser origins allowed by CORS, or * for any.
CORS_ORIGINS=http://localhost:3000

# mock (default) or live, per adapter. Live never falls back to mock on failure.
PAYMENT_MODE=mock
INSURANCE_MODE=mock
PAYOUT_MODE=mock

# Mock latency: "<min>-<max>" or a single number. Use 0 for fast rehearsals.
MOCK_LATENCY_MS=300-800
# One-shot failure drill: any of quote,pay,issue,payout,claim. Re-armed by POST /api/demo/reset.
MOCK_FAIL=

# ₦500,000 cap on a job, in kobo.
MAX_JOB_AMOUNT_KOBO=50000000
COVER_DURATION_DAYS=30

# --- Ecobank (needed when PAYMENT_MODE or PAYOUT_MODE is live) ------------------
# From the developer portal. Secrets: subscription key, public key, secret key / hashes.
# Check them with: npm run ecobank:token
ECOBANK_BASE_URL=https://apimuat-gateway.ecobank.com
ECOBANK_SUBSCRIPTION_KEY=
ECOBANK_AFFILIATE_CODE=
ECOBANK_CLIENT_ID=
ECOBANK_SOURCE_CODE=
ECOBANK_PUBLIC_KEY=
# Preferred: the secret key, so requestToken/secureHash are computed per request (SHA-512).
ECOBANK_SECRET_KEY=
# Fallback when there is no secret key: fixed values from the portal (token request only).
ECOBANK_REQUEST_TOKEN=
ECOBANK_SECURE_HASH=
ECOBANK_IP_ADDRESS=127.0.0.1
ECOBANK_PAYMENT_SERVICE_CODE=DOMESTIC
# XpressCash token generation. The UAT sample account is Ghanaian, so use GHS there.
ECOBANK_PAYOUT_SERVICE_CODE=TOKEN
ECOBANK_PAYOUT_CURRENCY=NGN
ECOBANK_TIMEOUT_MS=15000
# deploy